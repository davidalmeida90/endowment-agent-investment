  "reporting_standard": {
    "name": "Global Investment Performance Standards (GIPS)",
    "chapter": "GIPS Standards for Asset Owners",
    "edition": "2020 edition",
    "issued": "2019-06-30",
    "effective_date": "2020-01-01",
    "applies_from": "reports covering periods ending on or after 2020-12-31",
    "maintained_by": "CFA Institute",
    "applicable_because": "The Endowment is an asset owner that does not compete for business and reports to an oversight body (Introduction p. xiii; provision 21.A.2 names endowments explicitly). An asset owner that competes for business must instead follow the GIPS Standards for Firms (21.A.24).",
    "source_url": "https://www.gipsstandards.org/wp-content/uploads/2021/02/2020_gips_standards_asset_owners.pdf",
    "status": "VERIFIED",
    "benchmark_risk_statistic": {
      "provision": "24.A.1.j",
      "requirement": "Three-year annualised ex post standard deviation using monthly returns, for the total fund or composite AND the benchmark, as of each annual period end. Required for periods ending on or after 1 January 2011.",
      "if_36_months_unavailable": "24.C.30 requires disclosure that it is not presented because 36 monthly returns are not available.",
      "calculation": "Same formula for fund and benchmark (Guidance Statement on Benchmarks for Asset Owners, p. 25); periodicity and methodology must match for any additional risk measure (22.A.15)."
    },
    "blended_benchmark_disclosure": {
      "provisions": [
        "24.C.27",
        "24.C.28"
      ],
      "requirement": "24.C.27: disclose the benchmark components, weights and rebalancing process, the calculation methodology, and label it clearly as a custom benchmark. 24.C.28, which is asset-owner specific: where the total fund benchmark is a blend of asset class benchmarks at policy weights, disclose the benchmark used by each asset class with its weight as of the most recent annual period end, plus general information on the investments, structure and characteristics of those benchmarks.",
      "carve_out": "A change in the weights of the constituent benchmarks is not itself a benchmark change (Guidance Statement, p. 23)."
    },
    "fees": {
      "provisions": [
        "21.A.25",
        "24.A.1.b",
        "24.A.3.b",
        "24.A.4",
        "24.C.35"
      ],
      "requirement": "21.A.25 requires time-weighted returns for all total funds. 24.A.1.b requires total fund returns NET-OF-FEES, for periods beginning on or after 1 January 2015. For an asset owner, net-of-fees absorbs INVESTMENT MANAGEMENT COSTS, which the glossary defines to include internal investment office compensation, custody, data and a pro rata share of overhead. 24.A.3.b requires the return type be labelled. 24.A.4 requires full gross-of-fees returns to be identified as supplemental information. 24.C.35 requires disclosure of which return basis was used to compute the presented risk measures."
    },
    "track_record": {
      "provision": "24.A.1.a",
      "requirement": "At least one year of GIPS-compliant performance (or since inception if shorter), adding a year each year, building to a minimum of ten. The five-year opening requirement is the FIRMS rule at 4.A.1.a and does not apply to an asset owner.",
      "sub_annual": "22.A.9: returns for periods of less than one year must not be annualised. 24.A.1.d requires the return from inception through the first annual period end where the initial period is a stub."
    },
    "benchmark_change": {
      "provision": "24.C.26",
      "requirement": "For a prospective change, disclose the date and description, for as long as returns for the prior benchmark appear in the report. For a retroactive change, disclose the date and description for a minimum of one year and for as long as it is relevant to interpreting the track record. 24.C.25 requires disclosure of why no benchmark is presented if none is. Re-designating a primary benchmark as secondary counts as a change (Guidance Statement, p. 26)."
    },
    "distribution": {
      "provisions": [
        "21.A.11",
        "21.A.13",
        "21.A.27"
      ],
      "requirement": "A GIPS Asset Owner Report must be provided to the oversight body at least once every 12 months, updated through the most recent annual period end within 12 months of that period end, and a GIPS Compliance Notification Form filed with CFA Institute annually by 30 June."
    }
  }
